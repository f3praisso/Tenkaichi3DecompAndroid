# iOS: a sessao de audio do miniaudio mistura com o que o aparelho ja toca (ambient), em vez de tomar o som.
--- a/port/src/gs/snd_ma.c
+++ b/port/src/gs/snd_ma.c
@@ -37,6 +37,9 @@
 #define MA_IMPLEMENTATION
 #include "../../third_party/miniaudio/miniaudio.h"
 
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#endif
 #include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -85,7 +88,18 @@
 /* The engine, made the first time a native stream starts (so a run without one never touches a device here). */
 static int engine(void) {
     if (sEngineState == 0) {
-        if (ma_engine_init(NULL, &sEngine) == MA_SUCCESS) {
+        ma_engine_config ec = ma_engine_config_init();
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+        static ma_context sCtx;
+        ma_context_config cc = ma_context_config_init();
+        /* iOS: "ambient" mixes with what the phone is playing and follows the silent switch (the default session takes the sound over) */
+        cc.coreaudio.sessionCategory = ma_ios_session_category_ambient;
+        cc.coreaudio.sessionCategoryOptions = ma_ios_session_category_option_mix_with_others;
+        if (ma_context_init(NULL, 0, &cc, &sCtx) == MA_SUCCESS) {
+            ec.pContext = &sCtx;
+        }
+#endif
+        if (ma_engine_init(&ec, &sEngine) == MA_SUCCESS) {
             sEngineState = 1;
             atexit(engine_stop);
             fprintf(stderr, "bt3: sound: miniaudio %s (%u Hz), gain x%.2f\n", ma_version_string(), ma_engine_get_sample_rate(&sEngine), native_lift());
